# GEMINI_API_KEY: Required for server-side Gemini AI calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign custom JWT tokens on user authentication endpoints.
JWT_SECRET="marketplace-secret-key-12345"

# SQL_HOST: Path to local unix domain socket or hostname for PostgreSQL connections.
SQL_HOST="localhost"

# SQL_DB_NAME: Database name on the PostgreSQL instance.
SQL_DB_NAME="postgres"

# SQL_USER: Database user with read/write permissions for connection pooling.
SQL_USER="postgres"

# SQL_PASSWORD: Password for the app database user.
SQL_PASSWORD="my-app-password"

# SQL_ADMIN_USER: Database admin user for schema changes and migrations with Drizzle Kit.
SQL_ADMIN_USER="postgres"

# SQL_ADMIN_PASSWORD: Password for the admin database user.
SQL_ADMIN_PASSWORD="my-admin-password"
